<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <style>
      .main {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
      }

      .login {
        background-color: #0b132b;
        border-radius: 20px;
        width: 40vw;
        min-width: 500px;
        height: 68vh;
        min-height: 450px;
        color: white;
        padding: 40px;
        box-shadow: 10px 10px 25px #00000080;
      }

      .header {
        text-align: center;
      }

      .login input {
        display: block;
        margin: 10px auto;
        text-align: center;
        background: none;
        padding: 8px;
        font-size: 15px;
        border-radius: 22px;
        outline: none;
        color: white;
      }

      .login input[type="button"] {
        display: inline;
      }

      .login input[type="text"],
      .login input[type="password"] {
        border: 2px solid #3498db;
        width: 220px;
      }

      .login input[type="submit"] {
        width: 150px;
        border: 2px solid #2ecc71;
        cursor: pointer;
      }

      .login input[type="submit"]:hover {
        background-color: #2ecc71;
        transition: 0.5s;
      }

      .footer {
        background-color: #10335b;
        color: white;
        text-align: center;
        line-height: 110px;
        position: absolute;
        bottom: 0;
        width: 100%;
        height: 120px;
      }

      p {
        font-size: 20px;
        display: inline;
      }

      .email input,
      .password input,
      .phone input,
      .sex input,
      .name input,
      .address input {
        display: inline;
      }
    </style>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65"
      crossorigin="anonymous"
    />
  </head>

  <body>
    <nav class="navbar navbar-expand-lg" style="background-color: #114ab4">
      <div class="container navbar-text" style="padding: 4px 32px">
        <a class="navbar-brand col-1" href="/">
          <img
            src="./img/logo.svg"
            alt=""
            width="60"
            height="60"
            class="d-inline-block align-text-top"
          />
        </a>
        <a class="navbar-brand fs-2 col-3" href="/" style="color: white"
          >二手拍賣</a
        >

        <div class="col-4"></div>

        <div class="navbar-nav ms-auto mb-2 mb-lg-0"></div>
      </div>
    </nav>

    <div class="main">
      <form class="login" method="POST" action="">
        <h1 class="header">註冊新會員</h1>
        <div class="name">
          <p>會員名字：</p>
          <input type="text" name="name" placeholder="Name 會員名字" />
        </div>
        <div class="email">
          <p>電子信箱：</p>
          <input type="text" name="email" placeholder="Email 電子信箱" />
        </div>
        <div class="password">
          <p>密碼：</p>
          <input type="text" name="password" placeholder="Password 密碼" />
        </div>
        <div class="phone">
          <p>電話號碼：</p>
          <input type="text" name="phone" placeholder="Phone 電話號碼" />
        </div>
        <div class="address">
          <p>住址：</p>
          <input type="text" name="address" placeholder="Address 住址" />
        </div>
        <div class="sex">
          <p>性別：</p>
          <input type="radio" name="sex" value="1" /> 男
          <input type="radio" name="sex" value="0" /> 女
          <!-- <input type = 'text' name = 'sex' placeholder = 'Sex 性別'/> -->
        </div>
        <input type="submit" value="確定" />
      </form>
    </div>

    <footer class="footer" style="background-color: #10335b">
      <span>© Copright 2022 二手拍賣</span>
    </footer>
  </body>
</html>
