<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>二手拍賣</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="style.css" />
    <link rel="shortcut icon" href="./img/logo.svg" />
  </head>
  <body>
    <nav class="navbar navbar-expand-lg" style="background-color: #114ab4">
      <div class="container navbar-text" style="padding: 4px 32px">
        <a class="navbar-brand col-1" href="#">
          <img
            src="./img/logo.svg"
            alt=""
            width="60"
            height="60"
            class="d-inline-block align-text-top"
          />
        </a>
        <a class="navbar-brand fs-2 col-3" href="#" style="color: white"
          >二手拍賣</a
        >

        <form class="d-flex col-4" role="search">
          <input
            class="form-control me-2"
            type="search"
            placeholder="Search"
            aria-label="Search"
          />
          <button
            class="btn btn-outline-success px-2"
            type="submit"
            style="border: 0px"
          >
            <img src="./img/search.svg" />
          </button>
        </form>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
            <li class="nav-item dropdown">
              <a
                class="nav-link dropdown-toggle"
                href="#"
                role="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                style="color: white"
              >
                Hi, USER008
              </a>
              <ul class="dropdown-menu">
                <li>
                  <a class="dropdown-item" href="/seller/product_on"
                    >賣家模式</a
                  >
                </li>
                <li>
                  <a class="dropdown-item" href="/member/order">訂單管理</a>
                </li>
                <li>
                  <a class="dropdown-item" href="/member/shopping_cart"
                    >購物車</a
                  >
                </li>
                <li>
                  <a class="dropdown-item" href="/member/coupon">可用優惠券</a>
                </li>
                <li>
                  <hr class="dropdown-divider" />
                  <a class="dropdown-item" href="/admin">Log out</a>
                </li>
              </ul>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <section class="container">
      <div class="row">
        <div class="col-md-2">
          <div class="list-group sticky-top mt-3">
            <a
              href="/"
              class="list-group-item list-group-item-action active"
              data-toggle="list"
              >推薦商品</a
            >
            <a
              href="/?Category=0"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >女性衣物</a
            >
            <a
              href="/?Category=1"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >男性衣物</a
            >
            <a
              href="/?Category=2"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >運動類</a
            >
            <a
              href="/?Category=3"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >書籍</a
            >
            <a
              href="/?Category=4"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >居家生活用品</a
            >
            <a
              href="/?Category=5"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >男女鞋</a
            >
            <a
              href="/?Category=6"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >汽機車零件</a
            >
            <a
              href="/?Category=7"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >飾品配件</a
            >
            <a
              href="/?Category=8"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >遊戲週邊</a
            >
            <a
              href="/?Category=9"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >娛樂收藏品</a
            >
            <a
              href="/?Category=10"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >嬰幼兒</a
            >
            <a
              href="/?Category=11"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >寵物</a
            >
            <a
              href="/?Category=12"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >女生包包精品</a
            >
            <a
              href="/?Category=13"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >3c與電子零件用品周邊</a
            >
            <a
              href="/?Category=14"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >男生包包精品</a
            >
            <a
              href="/?Category=15"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >戶外用品</a
            >
            <a
              href="/?Category=16"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >文創</a
            >
            <a
              href="/?Category=17"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              >其他</a
            >
          </div>
        </div>

        <div class="col-md-10 mt-3 product_page">
          <% for(let i=0; i < recomend_product.length; i++){ %>
          <a href="/product/?p_id=<%=  recomend_product[i].Product_id %>">
            <div class="card pcard mb-4">
              <img src="<%= img[i].Image_path %>" onerror="this.onerror=null;this.src='/img/product-placeholder.svg';" />
              <div class="card-body">
                <h5 class="card-title fw-bold mb-4">
                  <%= recomend_product[i].Name %>
                </h5>
                <div class="container">
                  <div class="row">
                    <div class="col-6 ps-0">
                      $<%= recomend_product[i].Price %>
                    </div>
                    <div class="col-6 text-end user">
                      <img src="./img/user.svg" /><%=
                      recomend_product[i].Username %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </a>
          <% } %>
        </div>
      </div>
    </section>

    <footer class="footer-bg mt-5" style="background-color: #10335b">
      <div class="container py-5 text-center">
        <span style="color: white">© Copright 2022 二手拍賣</span>
      </div>
    </footer>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
