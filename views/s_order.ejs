<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Bootstrap demo</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    />
    <link rel="stylesheet" href="../../style.css" />
  </head>
  <body>
    <nav class="navbar navbar-expand-lg" style="background-color: #114ab4">
      <div class="container navbar-text" style="padding: 4px 32px">
        <a class="navbar-brand col-1" href="/">
          <img
            src="../../img/logo.png"
            alt=""
            width="60"
            height="60"
            class="d-inline-block align-text-top"
          />
        </a>
        <a class="navbar-brand fs-2 col-3" href="#" style="color: white"
          >二手拍賣</a
        >

        <form class="d-flex col-4" role="search">
          <input
            class="form-control me-2"
            type="search"
            placeholder="Search"
            aria-label="Search"
          />
          <button
            class="btn btn-outline-success px-2"
            type="submit"
            style="border: 0px"
          >
            <img src="../../img/search.svg" />
          </button>
        </form>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
            <li class="nav-item dropdown">
              <a
                class="nav-link dropdown-toggle"
                href="#"
                role="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                style="color: white"
              >
                Hi, USER008
              </a>
              <ul class="dropdown-menu">
                <li>
                  <a class="dropdown-item" href="/member/order">買家模式</a>
                </li>
                <li>
                  <a class="dropdown-item" href="/seller/product_on"
                    >商品上架</a
                  >
                </li>
                <li>
                  <a class="dropdown-item" href="/seller/product_m">商品管理</a>
                </li>
                <li>
                  <a class="dropdown-item" href="/seller/order">訂單管理</a>
                </li>
                <li>
                  <hr class="dropdown-divider" />
                  <a class="dropdown-item" href="/admin">Log out</a>
                </li>
              </ul>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <section class="container">
      <div class="row">
        <div class="col-md-2">
          <div class="list-group sticky-top mt-3">
            <a
              href="/seller/product_on"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              style="background-color: #f1f6ff"
              >商品上架</a
            >
            <a
              href="/seller/product_m"
              class="list-group-item list-group-item-action"
              data-toggle="list"
              style="background-color: #f1f6ff"
              >商品管理</a
            >
            <a
              href="/seller/order"
              class="list-group-item list-group-item-action active"
              data-toggle="list"
              >訂單管理</a
            >
          </div>
        </div>

        <div class="col-md-10 mt-3 product_page">
          <table class="table table-striped">
            <thead>
              <tr>
                <th scope="col">訂單編號</th>
                <th scope="col">商品名稱</th>
                <th scope="col">買家</th>
                <th scope="col">下單時間</th>
                <th scope="col">訂單狀態</th>
                <th scope="col">訂單金額</th>
                <th scope="col">評論</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">15</th>
                <td>Basketball</td>
                <td>USER007</td>
                <td>2023-01-10 03:20:30</td>
                <td>已下單</td>
                <td>$899</td>
                <td>未評論</td>
              </tr>
              <tr>
                <th scope="row">5</th>
                <td>二手保溫杯</td>
                <td>USER003</td>
                <td>2023-01-09 13:25:30</td>
                <td>已送達</td>
                <td>$1080</td>
                <td>
                  <div>
                    <span class="fa fa-star checked"></span>
                    <span class="fa fa-star checked"></span>
                    <span class="fa fa-star checked"></span>
                    <span class="fa fa-star checked"></span>
                    <span class="fa fa-star checked"></span>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <footer
      class="footer-bg mt-5 position-absolute bottom-0"
      style="background-color: #10335b; width: 100%"
    >
      <div class="container py-5 text-center">
        <span style="color: white">© Copright 2022 二手拍賣</span>
      </div>
    </footer>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
